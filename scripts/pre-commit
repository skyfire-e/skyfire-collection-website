#!/bin/sh
# Pre-commit hook: ensure SQLite WAL is checkpointed before any commit
# Prevents stale collection.db from being pushed to GitHub
# Also re-stages collection.db if checkpoint changed it

WAL_FILE="data/collection.db-wal"

if [ -f "$WAL_FILE" ]; then
  WAL_SIZE=$(wc -c < "$WAL_FILE" | tr -d ' ')
  if [ "$WAL_SIZE" -gt 0 ]; then
    echo "  SQLite WAL is not checkpointed ($WAL_SIZE bytes pending), running checkpoint..."
    npm run checkpoint --silent
    # Re-stage DB if it changed after checkpoint
    git diff --quiet -- data/collection.db || git add data/collection.db
    echo "  Checkpoint done, collection.db re-staged"
  fi
fi
