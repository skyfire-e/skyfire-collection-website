PORT=3000
NODE_ENV=development

ADMIN_USERNAME=admin
# ADMIN_PASSWORD_HASH required — generate with:
# node -e "const argon2 = require('argon2'); argon2.hash('YOUR_PASSWORD').then(h => console.log(h))"
ADMIN_PASSWORD_HASH=$argon2id$v=19$m=65536,t=3,p=4$...
# ADMIN_PASSWORD is deprecated (plaintext) — do not use in production

SESSION_SECRET=replace-with-random-secret-min-32-chars

# Optional
# COOKIE_SECURE=1        # Force secure cookies (auto-enabled in production)
# TRUST_PROXY=1           # Set to 1 behind reverse proxy (nginx, Caddy)
# SESSION_MAX_AGE=86400000  # Session TTL in ms (default 24h)
# ALLOWED_ORIGINS=example.com  # Comma-separated for CORS (default: req.hostname)
# SITE_URL=https://example.com  # Used in sitemap.xml (default: req.hostname)
# UPLOAD_FILE_SIZE=10485760    # Max file size in bytes (default 10MB)
# UPLOAD_MAX_FILES=10          # Max files per upload (default 10)
# UPLOAD_MAX_FIELDS=30         # Max form fields (default 30)
# SHUTDOWN_TIMEOUT=5000        # Graceful shutdown timeout in ms (default 5000)
# RATE_LIMIT_WRITE=300         # Write requests per 15 min for anonymous users (default 300)
# RATE_LIMIT_READ=2000         # Read requests per 15 min for anonymous users (default 2000)
#
# For production, set NODE_ENV=production:
# NODE_ENV=production
